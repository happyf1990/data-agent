        "\n",
        "# 如果前几页是目录，可把这些页的 OCR/抽取文本拼起来后解析。这里演示使用前 5 个 chunk 的文本。\n",
        "toc_text = \"\\n\".join(chunk.text for chunk in chunks[:5])\n",
